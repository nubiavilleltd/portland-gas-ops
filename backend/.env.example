DATABASE_URL=mysql+pymysql://user:password@localhost:3306/portland_gas_ops
DATABASE_SSL=false
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["http://localhost:3000","https://your-vercel-app.vercel.app"]
ENVIRONMENT=development

# Brevo (formerly Sendinblue) — get free API key at brevo.com
# Leave blank to disable email sending (OTP will be logged to console instead)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_FROM_EMAIL=you@gmail.com
BREVO_FROM_NAME=Portland Gas Operations

# Logo URL — set to your deployed frontend URL so the logo shows in emails
# Leave blank in development (falls back to PG text mark in emails)
LOGO_URL=https://your-vercel-app.vercel.app

# OTP settings
OTP_EXPIRE_MINUTES=10
