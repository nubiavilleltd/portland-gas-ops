DATABASE_URL=mysql+pymysql://user:password@localhost:3306/portland_gas_ops
DATABASE_SSL=false
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["http://localhost:3000","https://your-vercel-app.vercel.app"]
FRONTEND_URL=https://your-vercel-app.vercel.app
ENVIRONMENT=development

# Postmark — get a Server API Token at postmarkapp.com (Servers → your server → API Tokens)
# Leave blank to disable email sending (OTP will be logged to console instead)
POSTMARK_SERVER_TOKEN=your-postmark-server-token-here
POSTMARK_FROM_EMAIL=appnotice@nubiaville.com
POSTMARK_FROM_NAME=Portland Gas Operations

# Cloudinary — file storage and PDF hosting (cloudinary.com — free tier 10GB)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Logo URL — must be the direct URL to the image file itself, not the site root.
# Email clients fetch it anonymously, so it has to be publicly reachable (no auth redirect).
# Leave blank in development (falls back to PG text mark in emails)
LOGO_URL=https://your-vercel-app.vercel.app/Portland-gas-logo.png

# OTP settings
OTP_EXPIRE_MINUTES=10
